<Window x:Class="DumpbinGui.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DumpbinGui.App" Background="{DynamicResource Background}" Foreground="{DynamicResource Foreground}" FontFamily="Microsoft YaHei UI,Microsoft YaHei" FontSize="14" Title="dumpbin-gui V0.1" WindowStyle="None" Width="1220" Height="820" MinWidth="850" MinHeight="600" AllowDrop="True" Drop="OnDrop">
<WindowChrome.WindowChrome><WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome><Window.Resources><BooleanToVisibilityConverter x:Key="Bool"/></Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><DockPanel Margin="20,0,14,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="─" Style="{StaticResource CaptionButton}" Width="32" Height="26" Padding="0" Margin="2,0" VerticalAlignment="Center" Click="MinimizeWindow" ToolTip="Minimize"/><Button x:Name="MaximizeButton" Content="□" Style="{StaticResource CaptionButton}" Width="32" Height="26" Padding="0" Margin="2,0" VerticalAlignment="Center" Click="ToggleMaximize" ToolTip="Maximize / Restore"/><Button Content="✕" Style="{StaticResource CloseCaptionButton}" Width="32" Height="26" Padding="0" Margin="2,0" VerticalAlignment="Center" Click="CloseWindow" ToolTip="Close"/></StackPanel><TextBlock Text="dumpbin-gui" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/></DockPanel></Border><Grid Grid.Row="1" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,24"><Button DockPanel.Dock="Right" Content="{Binding [Settings],Source={x:Static local:Localization.Current}}" VerticalAlignment="Center" Command="{Binding ToggleSettingsCommand}"/><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="dumpbin-gui" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="V0.1" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="10,0,0,6"/><TextBlock Text="by utopio" FontSize="13" Opacity="0.6" VerticalAlignment="Bottom" Margin="12,0,0,6"/></StackPanel><TextBlock Text="{Binding [Subtitle],Source={x:Static local:Localization.Current}}" Opacity="0.6" Margin="0,6,0,0"/></StackPanel></DockPanel>
<Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,20"><DockPanel><Button DockPanel.Dock="Right" Content="{Binding [Browse],Source={x:Static local:Localization.Current}}" Click="BrowseFile" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding [DropHint],Source={x:Static local:Localization.Current}}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" Opacity="0.65" Margin="0,6,16,0"/><TextBlock Text="{Binding FileKind}" Opacity="0.5" FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
<TabControl Grid.Row="2" SelectedIndex="1"><TabItem x:Name="MembersTab" Header="库文件 / Library members"><DataGrid x:Name="MembersGrid" Margin="12" ItemsSource="{Binding Members}" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/></TabItem><TabItem Header="分析结果 / Analysis"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox x:Name="CategoriesList" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name"/><DataGrid x:Name="AnalysisGrid" Grid.Column="2" ItemsSource="{Binding SelectedCategory.Rows}" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserAddRows="False"/></Grid></TabItem><TabItem Header="{Binding [Output],Source={x:Static local:Localization.Current}}"><DockPanel Margin="12"><DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="{Binding [Save],Source={x:Static local:Localization.Current}}" Click="SaveOutput"/><Button DockPanel.Dock="Right" Content="{Binding [Search],Source={x:Static local:Localization.Current}}" Click="FindOutput"/><TextBox x:Name="SearchText" VerticalContentAlignment="Center"/></DockPanel><TextBox x:Name="OutputBox" Text="{Binding Output,Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" BorderThickness="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/></DockPanel></TabItem>
<TabItem Header="{Binding [Sections],Source={x:Static local:Localization.Current}}"><DockPanel Margin="12"><Button DockPanel.Dock="Bottom" Content="{Binding [Export],Source={x:Static local:Localization.Current}}" Click="ExportSection" HorizontalAlignment="Right"/><DataGrid x:Name="SectionsGrid" ItemsSource="{Binding Sections}" IsReadOnly="True" AutoGenerateColumns="True" SelectionMode="Single"/></DockPanel></TabItem>
<TabItem Header="{Binding [Resources],Source={x:Static local:Localization.Current}}"><DockPanel Margin="12"><Button DockPanel.Dock="Bottom" Content="{Binding [Export],Source={x:Static local:Localization.Current}}" Click="ExportResource" HorizontalAlignment="Right"/><DataGrid x:Name="ResourcesGrid" ItemsSource="{Binding Resources}" IsReadOnly="True" AutoGenerateColumns="True" SelectionMode="Single"/></DockPanel></TabItem></TabControl>
<DockPanel Grid.Row="3" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="{Binding [Cancel],Source={x:Static local:Localization.Current}}" Command="{Binding AnalyzeCancelCommand}" Visibility="{Binding IsBusy,Converter={StaticResource Bool}}"/><TextBlock Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.65" TextWrapping="Wrap"/></DockPanel>
<Border Grid.RowSpan="4" Width="460" HorizontalAlignment="Right" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="24" Visibility="{Binding SettingsOpen,Converter={StaticResource Bool}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="✕" Width="26" Height="26" Padding="0" VerticalAlignment="Center" Command="{Binding ToggleSettingsCommand}"/><TextBlock Text="{Binding [Settings],Source={x:Static local:Localization.Current}}" FontSize="24" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding [Appearance],Source={x:Static local:Localization.Current}}" Margin="0,30,0,12" Foreground="{DynamicResource Accent}"/><CheckBox Content="{Binding [DarkMode],Source={x:Static local:Localization.Current}}" IsChecked="{Binding DarkMode}"/><TextBlock Text="Language / 语言" Margin="0,24,0,12" Foreground="{DynamicResource Accent}"/><CheckBox Content="English" IsChecked="{Binding English}"/><TextBlock Text="dumpbin.exe" Margin="0,30,0,12" Foreground="{DynamicResource Accent}"/><TextBox Text="{Binding ToolPath,UpdateSourceTrigger=PropertyChanged}"/><Button Content="{Binding [Tool],Source={x:Static local:Localization.Current}}" Click="BrowseTool"/><Button x:Name="PrepareButton" Content="{Binding [Prepare],Source={x:Static local:Localization.Current}}" Click="PrepareTool"/></StackPanel></Border>
</Grid></Grid></Window>
